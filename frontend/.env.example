# Base URL of the Laravel API (no trailing slash).
# Dev: leave as /api (Vite proxies to php artisan serve on :8000).
# Web production: https://api.dilgo.app/api   (or https://dilgo.app/api if served on the same domain)
# Native apps MUST use an absolute https URL.
VITE_API_URL=/api
VITE_APP_NAME=DilGO
# Cloudflare Turnstile site key (optional — must match TURNSTILE_SECRET_KEY on the API)
VITE_TURNSTILE_SITE_KEY=
