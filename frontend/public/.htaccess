# DilGO SPA on Hostinger (Apache/LiteSpeed): HTTPS, security headers, caching, SPA routing.
# Cloudflare (or Hostinger's own WAF) sits in front; see docs/SECURITY.md.
Options -Indexes -MultiViews
ServerSignature Off

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Hidden files and leftovers never leave the server (.well-known stays reachable)
  RewriteRule (^|/)\.(?!well-known/) - [F,L]
  RewriteRule \.(sql|bak|old|swp|log|ini|sh|env|zip|tar|gz)$ - [F,L,NC]
  # Common scanner targets: answer 404 straight away instead of the SPA
  RewriteRule ^(wp-admin|wp-login\.php|wp-content|xmlrpc\.php|phpmyadmin|adminer|cgi-bin)(/|$) - [R=404,L,NC]

  # Leave the API folder (if the API is deployed under /api on the same domain) alone
  RewriteRule ^api(/.*)?$ - [L]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on' || %{HTTP:X-Forwarded-Proto} == 'https'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), geolocation=(), payment=(), usb=(), microphone=(self)"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  # API on the same domain under /api, or on api.dilgo.app. Turnstile, Google and Apple sign-in load their own frames.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' __INLINE_SCRIPT_HASHES__ https://challenges.cloudflare.com https://accounts.google.com https://appleid.cdn-apple.com; style-src 'self' 'unsafe-inline' https://accounts.google.com; img-src 'self' data: blob: https:; media-src 'self' blob: data: https:; font-src 'self' data:; connect-src 'self' https://api.dilgo.app https://challenges.cloudflare.com https://accounts.google.com https://appleid.apple.com; frame-src https://challenges.cloudflare.com https://accounts.google.com https://appleid.apple.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self' https://appleid.apple.com; frame-ancestors 'none'; upgrade-insecure-requests"
  Header unset X-Powered-By
  <FilesMatch "\.(js|css|woff2|svg|png|webp|jpg|mp4|webm|mp3)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/manifest+json
</IfModule>
