# ─────────────────────────────────────────────────────────────
#  DilGO API, environment template
#  Local dev: cp .env.example .env && php artisan key:generate
#  Hostinger: see ../docs/DEPLOY_HOSTINGER.md
# ─────────────────────────────────────────────────────────────
APP_NAME=DilGO
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
APP_LOCALE=tr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=tr_TR

FRONTEND_URL=http://localhost:5173
BRAND_SCHOOL="Bayrak Dil Okulları"
BRAND_SUPPORT_EMAIL=destek@dilgo.app

# Comma separated. Add https://dilgo.app (web), capacitor origins are for the native apps.
CORS_ALLOWED_ORIGINS=http://localhost:5173,capacitor://localhost,https://localhost

BCRYPT_ROUNDS=12
LOG_CHANNEL=daily
LOG_LEVEL=debug

# Local: sqlite. Hostinger: mysql (hPanel → Databases → MySQL Databases)
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_DATABASE=u123456789_dilgo
# DB_USERNAME=u123456789_dilgo
# DB_PASSWORD=

SESSION_DRIVER=array
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Mail, Hostinger SMTP (hPanel → Emails → create mailbox, e.g. no-reply@dilgo.app)
MAIL_MAILER=log
# MAIL_MAILER=smtp
# MAIL_SCHEME=smtps
# MAIL_HOST=smtp.hostinger.com
# MAIL_PORT=465
# MAIL_USERNAME=no-reply@dilgo.app
# MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@dilgo.app"
MAIL_FROM_NAME="${APP_NAME}"

# Security
AUTH_TOKEN_TTL_DAYS=60

# Social sign-in (leave empty to hide the buttons). Comma-separate several client ids.
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# Defne voice (optional). Without it the browser voice is used.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_NARRATOR_VOICE_ID=
# Neural English voice for words/lessons/stories (any one is enough; ElevenLabs above also works)
OPENAI_TTS_KEY=
OPENAI_TTS_VOICE=nova
GOOGLE_TTS_KEY=
GOOGLE_TTS_VOICE=en-GB-Neural2-C
SECURITY_MAX_FAILED_LOGINS=5
SECURITY_LOCK_MINUTES=15
# Minimum seconds per question before a lesson can be submitted (0 turns the check off)
LESSON_SECONDS_PER_QUESTION=1.5
ADMIN_REQUIRE_EMAIL_OTP=true
OTP_TTL_MINUTES=10
# Cloudflare Turnstile (optional bot protection; leave empty to disable)
TURNSTILE_SECRET_KEY=

# Application firewall (docs/SECURITY.md)
WAF_ENABLED=true
WAF_MAX_BODY_KB=1024
WAF_MAX_UPLOAD_KB=8192
WAF_STRIKES=8
WAF_STRIKE_WINDOW=10
WAF_BAN_MINUTES=60
WAF_ALLOW_IPS=

# AI teacher (Anthropic Claude)
AI_ENABLED=true
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
AI_EFFORT=low
AI_MAX_TOKENS=2048
AI_DAILY_LIMIT_FREE=10
# Premium alone keeps a taste of Defne; the Defne AI package (or Premium + Defne) is the full tutor
AI_DAILY_LIMIT_PREMIUM=30
AI_DAILY_LIMIT_DEFNE=300
# Gems a new account starts with (also editable in Yönetim > Site ayarları > Ekonomi)
SIGNUP_GEMS=300

# Payments: fake (dev only) | iyzico
PAYMENT_GATEWAY=fake
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
