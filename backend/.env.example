# ─────────────────────────────────────────────────────────────
#  DilGO API — environment template
#  Local dev: cp .env.example .env && php artisan key:generate
#  Hostinger: see ../docs/DEPLOY_HOSTINGER.md
# ─────────────────────────────────────────────────────────────
APP_NAME=DilGO
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
APP_LOCALE=tr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=tr_TR

FRONTEND_URL=http://localhost:5173
BRAND_SCHOOL="Bayrak Dil Okulları"
BRAND_SUPPORT_EMAIL=destek@dilgo.app

# Comma separated. Add https://dilgo.app (web) — capacitor origins are for the native apps.
CORS_ALLOWED_ORIGINS=http://localhost:5173,capacitor://localhost,https://localhost

BCRYPT_ROUNDS=12
LOG_CHANNEL=daily
LOG_LEVEL=debug

# Local: sqlite. Hostinger: mysql (hPanel → Databases → MySQL Databases)
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_DATABASE=u123456789_dilgo
# DB_USERNAME=u123456789_dilgo
# DB_PASSWORD=

SESSION_DRIVER=array
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Mail — Hostinger SMTP (hPanel → Emails → create mailbox, e.g. no-reply@dilgo.app)
MAIL_MAILER=log
# MAIL_MAILER=smtp
# MAIL_SCHEME=smtps
# MAIL_HOST=smtp.hostinger.com
# MAIL_PORT=465
# MAIL_USERNAME=no-reply@dilgo.app
# MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@dilgo.app"
MAIL_FROM_NAME="${APP_NAME}"

# Security
AUTH_TOKEN_TTL_DAYS=60
SECURITY_MAX_FAILED_LOGINS=5
SECURITY_LOCK_MINUTES=15
ADMIN_REQUIRE_EMAIL_OTP=true
OTP_TTL_MINUTES=10
# Cloudflare Turnstile (optional bot protection; leave empty to disable)
TURNSTILE_SECRET_KEY=

# AI teacher (Anthropic Claude)
AI_ENABLED=true
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
AI_EFFORT=low
AI_MAX_TOKENS=2048
AI_DAILY_LIMIT_FREE=10
AI_DAILY_LIMIT_PREMIUM=200

# Payments: fake (dev only) | iyzico
PAYMENT_GATEWAY=fake
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
