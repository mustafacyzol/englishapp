 "g8": {"label": "8. sınıf · LGS", "level": "A2", "units": [
  {"title": "Friendship", "tr": "Arkadaşlık", "words": [["accept","kabul etmek"],["refuse","reddetmek"],["invitation","davet"],["make an excuse","bahane bulmak"],["apologize","özür dilemek"],["rely on","güvenmek"],["get on well","iyi anlaşmak"],["hang out","takılmak"]], "sentences": [["Sorry, I can't come. I have to study.","Üzgünüm, gelemem. Ders çalışmam lazım."],["A true friend always supports you.","Gerçek bir arkadaş seni her zaman destekler."]], "note": "**LGS'de bu ünite:** davet kabul etme / reddetme ve bahane bildirme cümleleri sorulur. `Sure, why not?` kabul, `I'm sorry but I have to...` red ve bahanedir. Diyalog tamamlama sorularında seçeneklerdeki duygu ve tutuma dikkat et."},
  {"title": "Teen Life", "tr": "Genç yaşamı", "words": [["can't stand","hiç dayanamamak"],["prefer","tercih etmek"],["fancy","hoşlanmak"],["hate","nefret etmek"],["be into","ilgili olmak"],["teenager","genç"],["pocket money","harçlık"],["spare time","boş zaman"]], "sentences": [["I'm into rock music but I can't stand jazz.","Rock müziğe ilgim var ama caza dayanamam."],["Teenagers usually hang out at weekends.","Gençler genellikle hafta sonu takılır."]], "note": "**LGS'de bu ünite:** hoşlanma / hoşlanmama dereceleri (`love > like > don't mind > dislike > hate > can't stand`) ve sıklık zarfları tablo ya da grafikle sorulur. Grafikteki yüzdeleri cümlelerle eşleştirmeyi çalış."},
  {"title": "In the Kitchen", "tr": "Mutfakta", "words": [["recipe","tarif"],["ingredient","malzeme"],["chop","doğramak"],["boil","kaynatmak"],["pour","dökmek"],["stir","karıştırmak"],["slice","dilim"],["add","eklemek"]], "sentences": [["First, chop the onions. Then, add the tomatoes.","Önce soğanları doğra. Sonra domatesleri ekle."],["Boil the water and pour it into a bowl.","Suyu kaynat ve bir kaseye dök."]], "note": "**LGS'de bu ünite:** bir tarifin adımlarını `first, then, next, after that, finally` ile sıralama sorulur. Görsellerdeki adımları doğru sıraya koymayı çalış."},
  {"title": "On the Phone", "tr": "Telefonda", "words": [["call back","geri aramak"],["hang on","hatta kalmak"],["hold on","beklemek"],["take a message","mesaj almak"],["leave a message","mesaj bırakmak"],["speak up","yüksek sesle konuşmak"],["engaged","meşgul"],["Who's calling?","Kim arıyor?"]], "sentences": [["Can I leave a message for Elif?","Elif'e mesaj bırakabilir miyim?"],["Hold on, please. I'll put you through.","Lütfen bekleyin, sizi bağlıyorum."]], "note": "**LGS'de bu ünite:** telefon konuşmasında kalıp ifadeler (`Hold on`, `Can I speak to...?`, `I'll call back later`) ve mesaj notu okuma sorulur."},
