  {"title": "Adventures", "tr": "Maceralar", "words": [["rafting","rafting"],["paragliding","yamaç paraşütü"],["scuba diving","tüplü dalış"],["dangerous","tehlikeli"],["thrilling","heyecan verici"],["equipment","ekipman"],["safer","daha güvenli"],["the most exciting","en heyecanlı"]], "sentences": [["Paragliding is more exciting than camping.","Yamaç paraşütü kamp yapmaktan daha heyecan verici."],["Rafting is the most thrilling sport for me.","Benim için en heyecan verici spor rafting."]], "note": "**LGS'de bu ünite:** karşılaştırma ve üstünlük sıfatları (`more ... than`, `the most ...`) ile macera sporlarını karşılaştıran tablo soruları gelir."},
  {"title": "Tourism", "tr": "Turizm", "words": [["destination","gidilecek yer"],["accommodation","konaklama"],["sightseeing","gezip görme"],["souvenir","hatıra eşyası"],["have been to","-e gitmiş olmak"],["guide","rehber"],["historical site","tarihi yer"],["book a room","oda ayırtmak"]], "sentences": [["Have you ever been to Cappadocia?","Hiç Kapadokya'ya gittin mi?"],["We booked a room near the old town.","Eski şehre yakın bir oda ayırttık."]], "note": "**LGS'de bu ünite:** tatil tercihleri ve deneyimler (`Have you ever been to...?`) ile otel/tur bilgisi içeren ilanlardan bilgi bulma sorulur."},
